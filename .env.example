# Supabase — required for production
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — Edge Function only. Set in Supabase Dashboard → Project Settings → Edge Functions
# (or `supabase secrets set ANTHROPIC_API_KEY=...`). Never use a VITE_ prefix.
# ANTHROPIC_API_KEY=sk-ant-...

# Service role key — NEVER expose in client code or VITE_ variables.
# Use only in server-side scripts, CI migrations, Supabase Edge Functions,
# or the GitHub Actions keep-alive workflow (Settings → API → service_role).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
